<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>N.K. Production - Official Releases Radio</title>
  <style>
    :root {
      --bg-color: #0f172a;
      --card-bg: #1e293b;
      --accent-color: #ef4444;
      --accent-hover: #dc2626;
      --text-color: #f8fafc;
      --text-muted: #94a3b8;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background-color: var(--bg-color);
      color: var(--text-color);
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      padding: 20px;
    }

    .player-card {
      background-color: var(--card-bg);
      border-radius: 20px;
      padding: 24px;
      width: 100%;
      max-width: 480px;
      box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.5);
      border: 1px solid rgba(255, 255, 255, 0.1);
      text-align: center;
    }

    .header {
      margin-bottom: 20px;
    }

    .header h1 {
      font-size: 1.6rem;
      font-weight: 700;
      color: var(--text-color);
    }

    .header p {
      font-size: 0.85rem;
      color: var(--text-muted);
    }

    .video-container {
      position: relative;
      padding-bottom: 56.25%; /* 16:9 ratio */
      height: 0;
      overflow: hidden;
      border-radius: 12px;
      background-color: #000;
      margin-bottom: 20px;
    }

    .video-container iframe {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      border: 0;
    }

    .btn-shuffle {
      background-color: var(--accent-color);
      color: #ffffff;
      border: none;
      padding: 14px 28px;
      font-size: 1rem;
      font-weight: 600;
      border-radius: 9999px;
      cursor: pointer;
      width: 100%;
      transition: all 0.2s ease;
      box-shadow: 0 4px 12px rgba(239, 68, 68, 0.3);
    }

    .btn-shuffle:hover {
      background-color: var(--accent-hover);
      transform: translateY(-1px);
    }
  </style>
</head>
<body>

  <div class="player-card">
    <div class="header">
      <h1>N.K. Production</h1>
      <p>Official Releases Radio (@n.k.production)</p>
    </div>

    <div class="video-container">
      <iframe 
        id="releasePlayer"
        src="https://www.youtube.com/embed?listType=playlist&list=UUYwnDbrvHPeg4CNmQvSmGbA&autoplay=1" 
        title="N.K. Production Official Releases"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
        allowfullscreen>
      </iframe>
    </div>

    <button class="btn-shuffle" id="shuffleBtn">🔀 Play Next Random Release Track</button>
  </div>

  <script>
    // Playlist ID for N.K. Production's official uploads catalog
    // Converted from Channel ID (UCYwnDbrvHPeg4CNmQvSmGbA) to upload playlist
    const channelUploadPlaylist = "UUYwnDbrvHPeg4CNmQvSmGbA";

    const iframe = document.getElementById('releasePlayer');
    const shuffleBtn = document.getElementById('shuffleBtn');

    function playRandomTrack() {
      // Pick a random index between 0 and 100 to jump across N.K. Production's release catalog
      const randomIndex = Math.floor(Math.random() * 100);
      
      // Update iframe source with a random index start position
      iframe.src = `https://www.youtube.com/embed?listType=playlist&list=${channelUploadPlaylist}&index=${randomIndex}&autoplay=1`;
    }

    shuffleBtn.addEventListener('click', playRandomTrack);
  </script>

</body>
</html>
